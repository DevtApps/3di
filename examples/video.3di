# Vídeo curto com chaves de animação, câmera animada, roteiro com falas e legendas.
# Preview: a timeline embaixo da vista toca, pausa e arrasta o tempo; a legenda aparece por cima.
# Vídeo com voz:  node scripts/video.mjs examples/video.3di out/video.mp4
timeline(18, fps=30)

voice("narradora", speaker="Serena", language="Portuguese", instruct="tom animado de apresentadora")

chao = plane().color("#d9dee6")
pedestal = cylinder(0.6, 0.3, round=0.04).place(y=0).color("#3a3f4a")

# a joia sobe, gira e muda de brilho conforme as chaves
sobe = keys((0, 0.25), (2, 0.9), (15, 0.9), (17, 0.4))
joia = (sphere(0.32).elongate(y=0.18).color("#4f8cff").material(rough=0.15, coat=0.8, glow=keys((0, 0), (4, 0.2), (6, 1.2), (8, 0.2)))
        .rotate(y=keys((0, 0), (18, 1080), ease="linear"))
        .at(0, sobe, 0))

# satélites girando em volta (polar) e pulsando
satelites = sphere(0.07).color("#ffd166").material(glow=0.6).at(0.9, 0, 0).polar(6)
satelites = satelites.rotate(y=keys((0, 0), (18, -540), ease="linear")).scale(keys((0, 0.01), (3, 0.01), (4, 1), (18, 1))).at(0, 1.0, 0)

show(chao, pedestal, joia, satelites)

# câmera: aproxima, contorna e volta
camera(pos=keys((0, (0, 1.6, 5.5)), (6, (2.6, 1.4, 3.2)), (12, (-2.8, 2.2, 2.8)), (18, (0, 1.6, 5.5))),
       look=(0, 0.8, 0), fov=40)

# roteiro: say = fala + legenda (sem `at`, entra depois da anterior); caption = só legenda
say("Olá! Este é o novo sistema de vídeo do três D I.", voice="narradora")
say("Cada valor pode ter chaves no tempo: posição, giro, escala e brilho.", voice="narradora")
say("A câmera também segue chaves, e as falas viram legendas e áudio.", voice="narradora", style="mais devagar")
caption("feito com keys(), timeline(), say() e caption()", at=17, dur=1)

light(rim=0.5, fill=0.4)
sky("#1d2230")
