# Diorama de cemitério de Halloween (vista isométrica), só com funções genéricas da linguagem.
# Peças reutilizáveis (def) do próprio script: lajota, muro com grade, pilar, pinheiro, árvore
# seca, abóbora, caveira, lápide, lampião. Muro e lajotas usam repeat (não custam primitivas).

pedra = "#9a9c98"
pedra_escura = "#6f726f"
ferro = "#2b2d30"
laranja = "#e07a2e"
amarelo = "#e8a93a"
madeira = "#5a4a3c"
seed(7)

# ---- base: bloco de pedra com lajotas em relevo e caminho de paralelepípedos ----
W, D = 4.4, 3.4
base = box(W, 0.3, D, bevel=0.04).at(0, -0.15, 0).color(pedra_escura).texture("noise", size=0.3)
lajotas = box(0.52, 0.05, 0.52, bevel=0.015).color(pedra).texture("mottle", size=0.25).repeat(x=8, z=6, spacing=0.55).at(0, 0.025, 0)
caminho = box(0.17, 0.04, 0.17, bevel=0.012).color("#7d7f7c").repeat(x=4, z=14, spacing=0.19).at(-0.55, 0.06, 0.3)
patio = group(base, lajotas, caminho)

# ---- muro baixo com grade de ferro ----
def pilar(h=0.55):
    return group(box(0.2, h, 0.2, bevel=0.02).at(0, h / 2, 0),
                 box(0.26, 0.06, 0.26, bevel=0.015).at(0, h + 0.03, 0),
                 pyramid(0.18, 0.08).at(0, h + 0.1, 0)).color(pedra)

def grade(comprimento, eixo="x"):
    n = int(comprimento / 0.12)
    barra = group(cylinder(0.012, 0.42).at(0, 0.21, 0), cone(0.025, 0.06).at(0, 0.45, 0))
    barras = barra.repeat(x=n, spacing=0.12) if eixo == "x" else barra.repeat(z=n, spacing=0.12)
    trilho = box(comprimento, 0.025, 0.025) if eixo == "x" else box(0.025, 0.025, comprimento)
    muro = box(comprimento, 0.16, 0.14, bevel=0.015) if eixo == "x" else box(0.14, 0.16, comprimento, bevel=0.015)
    return group(muro.at(0, 0.08, 0).color(pedra).texture("noise", size=0.15),
                 group(barras, trilho.at(0, 0.36, 0), trilho.at(0, 0.2, 0)).at(0, 0.16, 0).color(ferro).material(metal=0.6, rough=0.5))

hx, hz = W / 2 - 0.15, D / 2 - 0.15
muros = group(
    grade(W - 0.5).at(0, 0, -hz),                    # fundo
    grade(D - 0.5, "z").at(-hx, 0, 0),               # esquerda
    grade(D - 0.5, "z").at(hx, 0, 0),                # direita
    grade(1.25).at(-1.35, 0, hz), grade(2.05).at(0.95, 0, hz),   # frente, com vão do portão
    pilar().at(-hx, 0, -hz), pilar().at(hx, 0, -hz), pilar().at(-hx, 0, hz), pilar().at(hx, 0, hz),
)

# ---- portão: dois pilares altos e arco ----
portao = group(
    pilar(0.8).at(-0.85, 0, hz), pilar(0.8).at(-0.2, 0, hz),
    intersect(torus(0.33, 0.05).rotate(x=90), box(1, 0.5, 0.2).at(0, 0.25, 0)).at(-0.525, 0.82, hz).color(pedra),
    box(0.06, 0.06, 0.06).at(-0.525, 1.18, hz).color(pedra),
)

# ---- cripta: corpo de pedra, base, colunas, porta em arco e telhado laranja de telhas ----
def telhado(w, d, h):
    t = prism(w, h, d).color(laranja).texture("bricks", size=0.16, color2="#b95a1f", bump=0.6)
    beiral = prism(w + 0.08, h + 0.03, d + 0.08).at(0, -0.02, 0).color("#c9662a")
    return merge(beiral, t, r=0.01, profile="groove")

cx, cz = 0.75, -0.5
corpo = box(1.3, 0.85, 1.0, bevel=0.03).at(0, 0.55, 0).color(pedra).texture("bricks", size=0.3, color2="#8a8c88", bump=0.4)
soco = box(1.45, 0.14, 1.15, bevel=0.03).at(0, 0.07, 0).color(pedra_escura)
cornija = box(1.4, 0.08, 1.1, bevel=0.02).at(0, 1.0, 0).color("#b4b6b2")
porta = group(box(0.4, 0.45, 0.2), cylinder(0.2, 0.2).rotate(x=90).at(0, 0.225, 0)).at(0, 0.38, 0.45)
batente = group(box(0.5, 0.5, 0.12), cylinder(0.25, 0.12).rotate(x=90).at(0, 0.25, 0)).at(0, 0.38, 0.51)
cripta = merge(corpo, soco, cornija, r=0.015, profile="groove") - porta
cripta = group(cripta,
               (batente - porta.at(0, 0, 0.05)).color("#b4b6b2"),
               box(0.36, 0.42, 0.02).at(0, 0.36, 0.42).color("#3c2e26"),   # porta de madeira
               cylinder(0.05, 0.62).at(0.45, 0.45, 0.56).color("#b4b6b2").mirror("x"),
               telhado(1.5, 1.2, 0.55).at(0, 1.31, 0),
               box(0.12, 0.25, 0.12).at(0.4, 1.35, -0.2).color(pedra_escura))     # chaminé
cripta = cripta.at(cx, 0.05, cz)

# ---- pinheiros laranja (cones empilhados, low poly) ----
def pinheiro(h=1.2, cor=laranja):
    copa = group(cone(0.32 * h, 0.5 * h).at(0, 0.45 * h, 0),
                 cone(0.25 * h, 0.42 * h).at(0, 0.72 * h, 0),
                 cone(0.17 * h, 0.35 * h).at(0, 0.96 * h, 0)).color(cor).facets(0.09, 0.15)
    return group(cylinder(0.04 * h, 0.3 * h).at(0, 0.15 * h, 0).color(madeira), copa)

pinheiros = group(
    pinheiro(1.4).at(-1.2, 0.05, -1.25), pinheiro(1.1, amarelo).at(-0.45, 0.05, -1.3),
    pinheiro(1.25).at(1.85, 0.05, -1.25), pinheiro(1.0, amarelo).at(1.9, 0.05, 0.35),
    pinheiro(0.9).at(1.55, 0.05, 0.85), pinheiro(0.8, amarelo).at(-1.85, 0.05, 1.2),
    pinheiro(0.7, amarelo).at(0.55, 0.05, 1.2),
)

# ---- árvores secas: tronco e galhos que afinam ----
def arvore_seca(h=1.0, giro=0):
    tronco = chain([(0, 0, 0), (0.03, 0.4 * h, 0), (-0.02, 0.75 * h, 0.02), (0.02, h, 0)], r=(0.045 * h, 0.012), curve=2)
    g1 = chain([(0.02, 0.5 * h, 0), (0.22 * h, 0.72 * h, 0.05), (0.3 * h, 0.85 * h, 0.02)], r=(0.022 * h, 0.006), curve=2)
    g2 = chain([(0, 0.62 * h, 0), (-0.2 * h, 0.82 * h, -0.04), (-0.25 * h, 0.95 * h, -0.08)], r=(0.02 * h, 0.006), curve=2)
    g3 = chain([(0, 0.35 * h, 0), (-0.14 * h, 0.48 * h, 0.08)], r=(0.018 * h, 0.006), curve=1)
    return group(tronco, g1, g2, g3).color("#4a4440").rotate(y=giro)

secas = group(arvore_seca(0.9).at(-1.75, 0.05, -0.6), arvore_seca(0.75, 70).at(-0.05, 0.05, -0.15),
              arvore_seca(0.8, 140).at(2.0, 0.05, -0.4), arvore_seca(0.6, 30).at(-1.0, 0.05, 1.3))

# ---- abóboras: gomos em volta do eixo (polar) e cabinho ----
def abobora(r=0.1):
    gomo = ellipsoid(0.45 * r, 0.8 * r, 0.6 * r).at(0.55 * r, 0, 0)
    corpo = group(gomo.polar(8), sphere(0.7 * r), smooth=0.3 * r).color("#e8701e").material(rough=0.5)
    cabo = segment((0, 0.7 * r, 0), (0.1 * r, 1.05 * r, 0.05 * r), r=0.12 * r, r2=0.07 * r).color("#5a6a2a")
    return group(corpo, cabo).at(0, 0.8 * r, 0)

aboboras = group(abobora(0.12).at(-1.55, 0.05, 0.25), abobora(0.08).at(-1.35, 0.05, 0.4),
                 abobora(0.1).at(0.3, 0.05, 0.75), abobora(0.13).at(0.2, 0.05, 1.45),
                 abobora(0.09).at(1.35, 0.05, 0.3), abobora(0.11).at(-0.9, 0.05, -0.9),
                 abobora(0.07).at(1.25, 0.05, 1.3), abobora(0.1).at(-0.1, 0.05, -1.0))

# ---- caveiras: crânio com órbitas pintadas e mandíbula ----
def caveira(r=0.07):
    cranio = merge(sphere(r), box(1.1 * r, 0.6 * r, 0.9 * r, round=0.25 * r).at(0, -0.6 * r, 0.25 * r), r=0.25 * r)
    cranio = cranio.color("#ece6d6").paint(sphere(0.28 * r).at(0.38 * r, -0.15 * r, 0.85 * r).mirror("x").color("#1a1614"), blend=0.004, relief=-0.004)
    cranio = cranio.paint(sphere(0.12 * r).at(0, -0.45 * r, 1.0 * r).color("#1a1614"), blend=0.003)
    return cranio.at(0, r, 0)

caveiras = group(caveira().rotate(y=20).at(-0.7, 0.05, 0.9), caveira(0.06).rotate(y=-30).at(1.05, 0.05, -1.1),
                 caveira(0.05).at(-1.6, 0.6, -1.55), caveira(0.055).rotate(y=40).at(0.55, 0.05, 0.4))

# ---- lápides e cruz ----
def lapide(w=0.22, h=0.32):
    return group(box(w, h * 0.7, 0.06, bevel=0.01).at(0, h * 0.35, 0), cylinder(w / 2, 0.06).rotate(x=90).at(0, h * 0.7, 0)).color("#a8aaa6")

def cruz(h=0.4):
    return group(box(0.05, h, 0.05, bevel=0.008).at(0, h / 2, 0), box(0.22, 0.05, 0.05, bevel=0.008).at(0, h * 0.7, 0)).color("#9ea09c")

tumulos = group(lapide().rotate(y=-10).at(-1.3, 0.05, -0.2), lapide(0.18, 0.26).rotate(y=8).at(-1.0, 0.05, 0.1),
                cruz().at(-1.65, 0.05, 0.7), lapide(0.2, 0.3).at(1.55, 0.05, -0.15), cruz(0.35).rotate(y=15).at(1.2, 0.05, 0.75))

# ---- lampiões: poste de ferro e lanterna acesa ----
def lampiao(h=0.9):
    poste = group(cylinder(0.022, h).at(0, h / 2, 0), box(0.08, 0.04, 0.08).at(0, 0.02, 0)).color(ferro)
    lanterna = group(box(0.1, 0.13, 0.1).at(0, h + 0.07, 0).color("#f3c25a").material(glow=1.2),
                     pyramid(0.14, 0.07).at(0, h + 0.17, 0).color(ferro))
    return group(poste, lanterna)

lampioes = group(lampiao().at(-0.95, 0.05, 1.45), lampiao(0.8).at(0.05, 0.05, -0.35), lampiao(0.85).at(1.95, 0.05, 1.45))

cena = group(patio, muros, portao, cripta, pinheiros, secas, aboboras, caveiras, tumulos, lampioes).name("cemiterio")
show(cena)

sun(0.5, 1, 0.7, color="#ffe9cf")
light(rim=0.35, fill=0.35)
sky("#30342f")
camera(pos=(5.2, 4.6, 5.6), look=(0.05, 0.25, 0), fov=34)
