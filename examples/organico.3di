# Formas orgânicas com união suave (smooth), twist e repeat.
seed(7)

# boneco de neve com junções suaves
corpo = group(
    sphere(0.6),
    sphere(0.42).at(0, 0.8, 0),
    sphere(0.3).at(0, 1.4, 0),
    smooth=0.12,
).color("snow").material(rough=0.9)
nariz = cone(0.05, 0.3).rotate(x=90).at(0, 1.42, 0.38).color("orange")
olho = sphere(0.035).at(0.1, 1.5, 0.27).mirror("x").color("black")
boneco = group(corpo, nariz, olho).place(-1.8, 0, 0).name("boneco")

# coluna torcida
coluna = box(0.5, 2.4, 0.5, round=0.05).twist(180).color("gold").material(metal=1, rough=0.3)
coluna = coluna.place(0, 0, 0).name("coluna")

# árvore: tronco + copa de esferas aleatórias unidas suavemente
tronco = cylinder(0.12, 1.2).place().color("darkwood")
folhas = [sphere(uniform(0.3, 0.45)).at(uniform(-0.4, 0.4), uniform(1.3, 1.8), uniform(-0.4, 0.4)) for _ in range(7)]
copa = group(folhas, smooth=0.25).color("leaf")
arvore = group(tronco, copa).place(1.8, 0, 0).name("árvore")

# cerca com repeat (40 estacas custam 1 primitiva)
estaca = box(0.08, 0.6, 0.08, round=0.02).color("wood")
cerca = estaca.repeat(x=40, spacing=0.2).place(0, 0, -1.6)
trilho = box(8, 0.06, 0.04).color("wood").place(0, 0.4, -1.6)

show(plane().color("snow"), boneco, coluna, arvore, cerca, trilho)
sky("#9cc3ea")
