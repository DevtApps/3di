# Filhote low poly sentado: cabeça grande, orelhas caídas, focinho com língua de fora.
# Mesmas ferramentas do gato: smooth para fundir, paint() para a pelagem, chain() para
# pernas e cauda, facets() para o visual low poly. De frente para +z, altura ~1.25.

caramelo = "#c98a45"
escuro = "#a86a32"
creme = "#f7e2bb"

# ---- corpo ----
quadril = ellipsoid(0.28, 0.24, 0.3).at(0, 0.25, -0.08)
peito = ellipsoid(0.23, 0.28, 0.21).rotate(x=-14).at(0, 0.47, 0.06)
pescoco = ellipsoid(0.18, 0.15, 0.16).at(0, 0.68, 0.08)
cranio = ellipsoid(0.27, 0.24, 0.23).at(0, 0.9, 0.08)
testa = ellipsoid(0.2, 0.12, 0.15).at(0, 1.0, 0.12)
focinho = ellipsoid(0.14, 0.1, 0.12).at(0, 0.8, 0.25)
bochechas = ellipsoid(0.075, 0.07, 0.07).at(0.08, 0.78, 0.27).mirror("x")

def perna(lado):
    return chain([(0.11 * lado, 0.5, 0.13), (0.11 * lado, 0.28, 0.17), (0.11 * lado, 0.07, 0.2)], r=(0.08, 0.062), curve=2)

pata = ellipsoid(0.075, 0.048, 0.095).at(0.11, 0.045, 0.24).mirror("x")
coxa = ellipsoid(0.13, 0.17, 0.2).rotate(x=-12).at(0.2, 0.2, -0.04).mirror("x")
pata_tras = ellipsoid(0.07, 0.042, 0.095).at(0.24, 0.04, 0.1).mirror("x")
cauda = chain([(0, 0.18, -0.36), (0.12, 0.26, -0.44), (0.2, 0.4, -0.46)], r=(0.055, 0.03), curve=3)

corpo = group(quadril, peito, pescoco, cranio, testa, focinho, bochechas,
              perna(1), perna(-1), pata, coxa, pata_tras, cauda, smooth=0.04).color(caramelo)

# boca aberta: um recorte suave no focinho, com a língua por dentro
boca = ellipsoid(0.09, 0.04, 0.07).rotate(x=-10).at(0, 0.74, 0.33)
corpo = corpo.subtract(boca, smooth=0.015)

manchas = [
    ellipsoid(0.16, 0.11, 0.13).at(0, 0.77, 0.27),             # focinho e queixo
    ellipsoid(0.15, 0.3, 0.12).rotate(x=-14).at(0, 0.5, 0.2),   # peito
    box(0.8, 0.12, 0.8).at(0, 0.03, 0.1),                     # patas
    sphere(0.06).at(0.2, 0.42, -0.46),                        # ponta da cauda
]
pelo = corpo
for m in manchas:
    pelo = pelo.paint(m.color(creme), blend=0.02)
# sobrancelhas mais escuras
pelo = pelo.paint(ellipsoid(0.05, 0.02, 0.04).rotate(z=12).at(0.09, 1.015, 0.27).mirror("x").color(escuro), blend=0.01)
pelo = pelo.facets(0.1, 0.18).material(rough=0.8)

# orelhas caídas: gotas achatadas presas no alto da cabeça, viradas para fora
def orelha(lado):
    o = chain([(0, 0, 0), (0, -0.16, 0.02), (0, -0.32, 0.0)], r=[0.09, 0.125, 0.095], curve=2).scale((0.4, 1, 1))
    return o.rotate(x=10, y=-25 * lado, z=14 * lado).at(0.25 * lado, 1.02, 0.1)

orelhas = group(orelha(1), orelha(-1)).color(escuro).facets(0.09, 0.15).material(rough=0.8)

def olho(lado):
    globo = sphere(0.056).color("#6e3b1c").material(rough=0.12)
    globo = globo.paint(sphere(0.027).at(0, 0, 0.04).color("#120806"), blend=0.004)
    globo = globo.paint(sphere(0.014).at(0.015, 0.02, 0.048).color("white").material(glow=0.6), blend=0.002)
    contorno = sphere(0.061).at(0, 0, -0.008).color("#1c0e08")
    return group(contorno, globo).at(0.1 * lado, 0.93, 0.27)

nariz = ellipsoid(0.06, 0.042, 0.045).at(0, 0.84, 0.37).color("#2c1a14").material(rough=0.3).facets(0.03, 0.1)
lingua = ellipsoid(0.055, 0.018, 0.065).rotate(x=28).at(0, 0.725, 0.33).color("#e58a92").material(rough=0.35)
labio = segment((0, 0.805, 0.38), (0, 0.775, 0.375), r=0.006).color("#3a2218")

cachorro = group(pelo, orelhas, olho(1), olho(-1), nariz, lingua, labio).name("cachorro")
show(cachorro)

sky("#cfd1d6")
camera(pos=(-0.25, 0.9, 2.6), look=(0, 0.6, 0), fov=40)
