{
  "scopeName": "source.3di",
  "patterns": [
    {
      "name": "comment.line.number-sign.3di",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.3di",
      "begin": "[fF]?\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.3di"
        }
      ]
    },
    {
      "name": "string.quoted.single.3di",
      "begin": "[fF]?'",
      "end": "'",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.3di"
        }
      ]
    },
    {
      "name": "keyword.control.3di",
      "match": "\\b(def|return|for|in|if|elif|else|while|and|or|not|pass|break|continue|lambda|is)\\b"
    },
    {
      "name": "constant.language.3di",
      "match": "\\b(True|False|None|time|pi)\\b"
    },
    {
      "name": "constant.numeric.3di",
      "match": "\\b\\d[\\d_]*(\\.\\d*)?([eE][+-]?\\d+)?"
    },
    {
      "name": "entity.name.function.3di",
      "match": "\\b[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()"
    }
  ]
}