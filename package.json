{
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "monaco-editor": "0.52.2",
    "zod": "^4.6.7"
  },
  "scripts": {
    "app": "npm run desktop:build && node scripts/run-desktop.mjs",
    "mcp": "npm run dev",
    "install-desktop": "node scripts/install-desktop.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node --watch scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "desktop:build": "npm run build",
    "desktop:deb": "npm run desktop:build && electron-builder --linux deb --config electron-builder.yml",
    "desktop:smoke": "npm run desktop:build && node scripts/run-desktop.mjs --smoke",
    "predev": "npm run desktop:build",
    "vendor:three": "node scripts/vendor-three.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "three": "0.160.0",
    "typescript": "^7.0.2"
  },
  "name": "3di-engine",
  "displayName": "3DI — 3D Engine",
  "description": "Crie cenas 3D com código: preview WebGL, linguagem 3DI, projetos e MCP HTTP.",
  "version": "0.4.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  }
}
